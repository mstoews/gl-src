//
// taskpages.rc - the task page's form (spec #8 5.3; plan S8-M4 task 6). Written
// by hand; #included by port.rc. Plain ASCII. One form for every task: the
// action, the list with check boxes, the summary, progress and the result.
// The second row (pay date, bank, first cheque) is Create Cheques' (spec #8
// G8); the other tasks hide it and the list takes its room. The row command
// (Renumber, Void), its number, and the page's other command (Print cheques)
// are the cheque pages' (spec #9 S9-M3); the other tasks hide them.
// IDs in gl/port/PortIds.h ("task pages", 22400-22419).
//

IDD_PG_TASK DIALOGEX 0, 0, 600, 330
STYLE DS_CONTROL | WS_CHILD
EXSTYLE WS_EX_CONTROLPARENT
FONT 9, "Segoe UI"
{
 PUSHBUTTON "R&un", IDC_TK_ACTION, 4, 4, 84, 14
 PUSHBUTTON "S&top", IDC_TK_STOP, 92, 4, 48, 14
 PUSHBUTTON "Check &all", IDC_TK_ALL, 148, 4, 56, 14
 PUSHBUTTON "Check &none", IDC_TK_NONE, 208, 4, 56, 14
 PUSHBUTTON "&Refresh", IDC_TK_REFRESH, 268, 4, 52, 14
 LTEXT "", IDC_TK_LOPTION, 330, 7, 64, 8
 CONTROL "", IDC_TK_DATE, "SysDateTimePick32", DTS_SHORTDATEFORMAT | WS_TABSTOP, 396, 4, 72, 12
 COMBOBOX IDC_TK_PERIOD, 396, 4, 110, 80, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
 LTEXT "Ne&w number:", IDC_TK_LROWIN, 330, 7, 64, 8
 EDITTEXT IDC_TK_ROWIN, 396, 4, 72, 12, ES_NUMBER | ES_AUTOHSCROLL
 PUSHBUTTON "&Print cheques", IDC_TK_PAGECMD, 476, 4, 60, 14
 PUSHBUTTON "Ren&umber", IDC_TK_ROW, 540, 4, 56, 14
 LTEXT "&Pay on:", IDC_TK_LPAYDATE, 4, 23, 40, 8
 CONTROL "", IDC_TK_PAYDATE, "SysDateTimePick32", DTS_SHORTDATEFORMAT | WS_TABSTOP, 46, 20, 72, 12
 LTEXT "Ban&k:", IDC_TK_LBANK, 128, 23, 26, 8
 COMBOBOX IDC_TK_BANK, 156, 20, 160, 80, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
 LTEXT "First c&heque:", IDC_TK_LNUMBER, 326, 23, 50, 8
 EDITTEXT IDC_TK_NUMBER, 378, 20, 60, 12, ES_NUMBER | ES_AUTOHSCROLL
 LTEXT "", IDC_TK_SUMMARY, 4, 36, 592, 8, SS_ENDELLIPSIS | SS_NOPREFIX
 CONTROL "", IDC_TK_LIST, "SysListView32", LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | LVS_NOSORTHEADER | WS_BORDER | WS_TABSTOP, 4, 48, 592, 248
 CONTROL "", IDC_TK_PROGRESS, "msctls_progress32", WS_BORDER, 4, 300, 592, 10
 LTEXT "", IDC_TK_RESULT, 4, 314, 592, 12, SS_ENDELLIPSIS | SS_NOPREFIX
}
