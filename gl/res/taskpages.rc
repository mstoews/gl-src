//
// taskpages.rc - the task page's form (spec #8 5.3; plan S8-M4 task 6). Written
// by hand; #included by port.rc. Plain ASCII. One form for every task: the
// action, the list with check boxes, the summary, progress and the result.
// IDs in gl/port/PortIds.h ("task pages", 22400-22419).
//

IDD_PG_TASK DIALOGEX 0, 0, 600, 330
STYLE DS_CONTROL | WS_CHILD
EXSTYLE WS_EX_CONTROLPARENT
FONT 9, "Segoe UI"
{
 PUSHBUTTON "R&un", IDC_TK_ACTION, 4, 4, 84, 14
 PUSHBUTTON "S&top", IDC_TK_STOP, 92, 4, 48, 14
 PUSHBUTTON "Check &all", IDC_TK_ALL, 148, 4, 56, 14
 PUSHBUTTON "Check &none", IDC_TK_NONE, 208, 4, 56, 14
 PUSHBUTTON "&Refresh", IDC_TK_REFRESH, 268, 4, 52, 14
 LTEXT "", IDC_TK_LOPTION, 330, 7, 64, 8
 CONTROL "", IDC_TK_DATE, "SysDateTimePick32", DTS_SHORTDATEFORMAT | WS_TABSTOP, 396, 4, 72, 12
 COMBOBOX IDC_TK_PERIOD, 396, 4, 110, 80, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
 LTEXT "", IDC_TK_SUMMARY, 4, 22, 592, 8, SS_ENDELLIPSIS | SS_NOPREFIX
 CONTROL "", IDC_TK_LIST, "SysListView32", LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | LVS_NOSORTHEADER | WS_BORDER | WS_TABSTOP, 4, 34, 592, 262
 CONTROL "", IDC_TK_PROGRESS, "msctls_progress32", WS_BORDER, 4, 300, 592, 10
 LTEXT "", IDC_TK_RESULT, 4, 314, 592, 12, SS_ENDELLIPSIS | SS_NOPREFIX
}
