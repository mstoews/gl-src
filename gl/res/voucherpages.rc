// ---- Clear Receipts ------------------------------------------------------------------------

IDD_PG_RECEIPTS DIALOGEX 0, 0, 600, 330
STYLE DS_CONTROL | WS_CHILD
EXSTYLE WS_EX_CONTROLPARENT
FONT 9, "Segoe UI"
{
 EDITTEXT IDC_RCP_FILTER, 4, 4, 230, 12, ES_AUTOHSCROLL
 AUTOCHECKBOX "Show &paid invoices", IDC_RCP_ALL, 240, 6, 90, 10
 CONTROL "", IDC_RCP_LIST, "SysListView32", LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | LVS_OWNERDATA | WS_BORDER | WS_TABSTOP, 4, 20, 326, 306

 GROUPBOX "Receipt", IDC_RCP_GROUP, 338, 16, 258, 150
 LTEXT "", IDC_RCP_WHO, 346, 30, 242, 8, SS_ENDELLIPSIS | SS_NOPREFIX
 LTEXT "", IDC_RCP_WHAT, 346, 42, 242, 8, SS_ENDELLIPSIS | SS_NOPREFIX
 LTEXT "Da&te:", -1, 346, 58, 50, 8
 CONTROL "", IDC_RCP_DATE, "SysDateTimePick32", DTS_SHORTDATEFORMAT | WS_TABSTOP, 398, 56, 70, 12
 LTEXT "&Bank:", -1, 346, 74, 50, 8
 COMBOBOX IDC_RCP_BANK, 398, 72, 150, 80, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
 LTEXT "&Amount:", -1, 346, 90, 50, 8
 EDITTEXT IDC_RCP_AMOUNT, 398, 88, 70, 12, ES_RIGHT | ES_AUTOHSCROLL
 AUTOCHECKBOX "&Discount the rest (early payment)", IDC_RCP_DISCOUNT, 398, 104, 150, 10
 LTEXT "&Reference:", -1, 346, 120, 50, 8
 EDITTEXT IDC_RCP_REF, 398, 118, 100, 12, ES_AUTOHSCROLL
 DEFPUSHBUTTON "R&ecord receipt", IDC_RCP_RECORD, 398, 138, 80, 14
 PUSHBUTTON "Re&verse last receipt", IDC_RCP_REVERSE, 482, 138, 90, 14
}

// ---- The voucher list -------------------------------------------------------------------------

IDD_PG_VOUCHERLIST DIALOGEX 0, 0, 600, 330
