 LTEXT "", IDC_VP_STATE, 228, 7, 368, 8, SS_ENDELLIPSIS | SS_NOPREFIX

 GROUPBOX "Invoice", IDC_VP_GHEADER, 4, 20, 592, 90
 LTEXT "&Vendor:", -1, 12, 34, 44, 8
 EDITTEXT IDC_APV_VENDOR, 58, 32, 44, 12, ES_UPPERCASE | ES_AUTOHSCROLL
 LTEXT "", IDC_APV_VNAME, 106, 34, 130, 8, SS_ENDELLIPSIS | SS_NOPREFIX
 LTEXT "&Invoice No.:", -1, 244, 34, 46, 8
 EDITTEXT IDC_APV_INVOICE, 292, 32, 60, 12, ES_AUTOHSCROLL
 LTEXT "&Order No.:", -1, 362, 34, 40, 8
 EDITTEXT IDC_APV_ORDER, 404, 32, 60, 12, ES_AUTOHSCROLL
 LTEXT "Invoice da&te:", -1, 12, 48, 44, 8
 CONTROL "", IDC_APV_INVDATE, "SysDateTimePick32", DTS_SHORTDATEFORMAT | WS_TABSTOP, 58, 46, 70, 12
 LTEXT "Due date:", IDC_APV_LDUE, 136, 48, 36, 8
 CONTROL "", IDC_APV_DUEDATE, "SysDateTimePick32", DTS_SHORTDATEFORMAT | DTS_SHOWNONE | WS_TABSTOP, 174, 46, 70, 12
 LTEXT "Pe&riod:", -1, 254, 48, 36, 8
 COMBOBOX IDC_APV_PERIOD, 292, 46, 110, 80, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
 LTEXT "Doc&ument:", -1, 12, 62, 44, 8
 EDITTEXT IDC_APV_REF, 58, 60, 70, 12, ES_AUTOHSCROLL
 LTEXT "Terms:", IDC_APV_LTERMS, 136, 62, 36, 8
 EDITTEXT IDC_APV_TERMS, 174, 60, 24, 12, ES_NUMBER
 LTEXT "VAT %:", -1, 206, 62, 26, 8
 EDITTEXT IDC_APV_VATRATE, 234, 60, 20, 12, ES_NUMBER
 LTEXT "W/H %:", -1, 262, 62, 28, 8
 EDITTEXT IDC_APV_WHRATE, 292, 60, 20, 12, ES_NUMBER
 LTEXT "T&ype:", -1, 320, 62, 22, 8
 COMBOBOX IDC_APV_TYPE, 344, 60, 70, 60, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
 LTEXT "AP account:", IDC_APV_LCREDIT, 12, 76, 44, 8
 EDITTEXT IDC_APV_CREDIT, 58, 74, 44, 12, ES_UPPERCASE | ES_AUTOHSCROLL
 EDITTEXT IDC_APV_CREDITDEPT, 104, 74, 20, 12, ES_UPPERCASE | ES_AUTOHSCROLL
 COMBOBOX IDC_APV_BANK, 58, 74, 120, 80, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
 LTEXT "", IDC_APV_CREDITNAME, 182, 76, 110, 8, SS_ENDELLIPSIS | SS_NOPREFIX
 LTEXT "VAT account:", -1, 300, 76, 46, 8
 EDITTEXT IDC_APV_VAT, 348, 74, 44, 12, ES_UPPERCASE | ES_AUTOHSCROLL
 EDITTEXT IDC_APV_VATDEPT, 394, 74, 20, 12, ES_UPPERCASE | ES_AUTOHSCROLL
 LTEXT "", IDC_APV_VATNAME, 418, 76, 170, 8, SS_ENDELLIPSIS | SS_NOPREFIX
 LTEXT "C&heque:", IDC_APV_LCHEQUE, 12, 92, 44, 8
 EDITTEXT IDC_APV_CHEQUE, 58, 90, 60, 12, ES_AUTOHSCROLL

 CONTROL "", IDC_VP_GRID, "SysListView32", LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | LVS_OWNERDATA | WS_BORDER | WS_TABSTOP, 4, 114, 592, 116
 LTEXT "The voucher's lines, as saved:", IDC_VP_LSPLIT, 4, 234, 200, 8
 CONTROL "", IDC_VP_SPLIT, "SysListView32", LVS_REPORT | LVS_SINGLESEL | LVS_NOSORTHEADER | WS_BORDER | WS_TABSTOP, 4, 244, 592, 62

 LTEXT "Debits:", IDC_VP_LDEBIT, 4, 312, 30, 8
 RTEXT "", IDC_VP_DEBIT, 34, 312, 70, 8
 LTEXT "Credits:", IDC_VP_LCREDIT, 112, 312, 30, 8
 RTEXT "", IDC_VP_CREDIT, 142, 312, 70, 8
 LTEXT "Payable:", IDC_VP_LDIFF, 220, 312, 40, 8
 RTEXT "", IDC_VP_DIFF, 260, 312, 70, 8
 LTEXT "", IDC_VP_STATUS, 340, 312, 256, 8, SS_ENDELLIPSIS | SS_NOPREFIX
}

