 AUTOCHECKBOX "Show p&osted vouchers", IDC_VL_POSTED, 124, 6, 100, 10
 EDITTEXT IDC_VL_FILTER, 232, 4, 180, 12, ES_AUTOHSCROLL
 CONTROL "", IDC_VL_LIST, "SysListView32", LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | LVS_OWNERDATA | WS_BORDER | WS_TABSTOP, 4, 22, 592, 304
}
