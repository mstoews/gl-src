//
// voucherpages.rc - the voucher pages' forms (spec #8 5.2; plan S8-M3).
// Written by hand; #included by port.rc. Plain ASCII. IDs in gl/port/PortIds.h
// ("voucher pages", 22000-22399). Each form is WS_CHILD | DS_CONTROL, laid out
// by anchors (pages/VoucherPages.cpp) and checked by /checkres.
//

// ---- General Ledger voucher (and Prior Period Entry's adjustments) ----------

// Button rows: New, Save, Post, then Delete set apart (design review: a destructive action
// is not placed between two primary ones).
IDD_PG_GLVOUCHER DIALOGEX 0, 0, 600, 330
STYLE DS_CONTROL | WS_CHILD
EXSTYLE WS_EX_CONTROLPARENT
FONT 9, "Segoe UI"
{
 PUSHBUTTON "&New", IDC_PG_NEW, 4, 4, 48, 14
 PUSHBUTTON "&Save", IDC_PG_SAVE, 56, 4, 48, 14
 PUSHBUTTON "&Post", IDC_VP_POST, 108, 4, 48, 14
 PUSHBUTTON "&Delete", IDC_PG_DELETE, 168, 4, 48, 14
 PUSHBUTTON "< Pre&vious", IDC_VP_PREV, 228, 4, 56, 14
 PUSHBUTTON "Ne&xt >", IDC_VP_NEXT, 288, 4, 56, 14
 PUSHBUTTON "Print s&lip", IDC_VP_PRINT, 352, 4, 56, 14
 LTEXT "", IDC_VP_STATE, 416, 7, 180, 8, SS_ENDELLIPSIS | SS_NOPREFIX

 GROUPBOX "Voucher", IDC_VP_GHEADER, 4, 20, 592, 46
 LTEXT "Da&te:", -1, 12, 34, 36, 8
 CONTROL "", IDC_GLV_DATE, "SysDateTimePick32", DTS_SHORTDATEFORMAT | WS_TABSTOP, 52, 32, 70, 12
 LTEXT "Pe&riod:", -1, 132, 34, 30, 8
 COMBOBOX IDC_GLV_PERIOD, 164, 32, 110, 80, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
 LTEXT "C&heque:", -1, 284, 34, 32, 8
 EDITTEXT IDC_GLV_CHEQUE, 318, 32, 50, 12, ES_AUTOHSCROLL
 LTEXT "Descr&iption:", -1, 12, 50, 40, 8
 EDITTEXT IDC_GLV_DESC, 52, 48, 316, 12, ES_AUTOHSCROLL

 CONTROL "", IDC_VP_GRID, "SysListView32", LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | LVS_OWNERDATA | WS_BORDER | WS_TABSTOP, 4, 70, 592, 236

 LTEXT "Debits:", IDC_VP_LDEBIT, 4, 312, 30, 8
 RTEXT "", IDC_VP_DEBIT, 34, 312, 70, 8
 LTEXT "Credits:", IDC_VP_LCREDIT, 112, 312, 30, 8
 RTEXT "", IDC_VP_CREDIT, 142, 312, 70, 8
 LTEXT "Difference:", IDC_VP_LDIFF, 220, 312, 40, 8
 RTEXT "", IDC_VP_DIFF, 260, 312, 70, 8
 LTEXT "", IDC_VP_STATUS, 340, 312, 256, 8, SS_ENDELLIPSIS | SS_NOPREFIX
}

// ---- Purchase and cash invoice vouchers ----------------------------------------

IDD_PG_APVOUCHER DIALOGEX 0, 0, 600, 330
STYLE DS_CONTROL | WS_CHILD
EXSTYLE WS_EX_CONTROLPARENT
FONT 9, "Segoe UI"
{
 PUSHBUTTON "&New", IDC_PG_NEW, 4, 4, 48, 14
 PUSHBUTTON "&Save", IDC_PG_SAVE, 56, 4, 48, 14
 PUSHBUTTON "&Post", IDC_VP_POST, 108, 4, 48, 14
