//
// homepages.rc - the home page and the report gallery (spec #8 5.4, 5.5;
// plan S8-M5). Written by hand; #included by port.rc. Plain ASCII. IDs in
// gl/port/PortIds.h ("home and gallery", 22500-22549).
//

#ifndef BS_COMMANDLINK
#define BS_COMMANDLINK 0x0000000EL
#endif

IDD_PG_HOME DIALOGEX 0, 0, 600, 330
STYLE DS_CONTROL | WS_CHILD
EXSTYLE WS_EX_CONTROLPARENT
FONT 9, "Segoe UI"
{
 LTEXT "", IDC_HM_HEADING, 4, 4, 520, 10, SS_NOPREFIX | SS_ENDELLIPSIS
 PUSHBUTTON "&Refresh", IDC_HM_REFRESH, 544, 2, 52, 14
 CONTROL "Period", IDC_HM_TILE0, "Button", BS_COMMANDLINK | WS_TABSTOP, 4, 20, 192, 36
 CONTROL "GL vouchers", IDC_HM_TILE1, "Button", BS_COMMANDLINK | WS_TABSTOP, 202, 20, 192, 36
 CONTROL "AP vouchers", IDC_HM_TILE2, "Button", BS_COMMANDLINK | WS_TABSTOP, 400, 20, 196, 36
 CONTROL "AR vouchers", IDC_HM_TILE3, "Button", BS_COMMANDLINK | WS_TABSTOP, 4, 60, 192, 36
 CONTROL "Journals", IDC_HM_TILE4, "Button", BS_COMMANDLINK | WS_TABSTOP, 202, 60, 192, 36
 CONTROL "Cheques", IDC_HM_TILE5, "Button", BS_COMMANDLINK | WS_TABSTOP, 400, 60, 196, 36
 CONTROL "Depreciation", IDC_HM_TILE6, "Button", BS_COMMANDLINK | WS_TABSTOP, 4, 100, 192, 36
 CONTROL "Receivables", IDC_HM_TILE7, "Button", BS_COMMANDLINK | WS_TABSTOP, 202, 100, 192, 36
 CONTROL "Payables", IDC_HM_TILE8, "Button", BS_COMMANDLINK | WS_TABSTOP, 400, 100, 196, 36
 CONTROL "Reports", IDC_HM_TILE9, "Button", BS_COMMANDLINK | WS_TABSTOP, 4, 140, 192, 36
 CONTROL "Search", IDC_HM_TILE10, "Button", BS_COMMANDLINK | WS_TABSTOP, 202, 140, 192, 36
 GROUPBOX "Recent pages", IDC_HM_GRECENT, 4, 182, 294, 144
 LISTBOX IDC_HM_RECENT, 12, 196, 278, 124, LBS_NOTIFY | LBS_NOINTEGRALHEIGHT | WS_VSCROLL | WS_TABSTOP
 GROUPBOX "Favourite reports", IDC_HM_GFAV, 304, 182, 292, 144
 LISTBOX IDC_HM_FAVOURITES, 312, 196, 276, 124, LBS_NOTIFY | LBS_NOINTEGRALHEIGHT | WS_VSCROLL | WS_TABSTOP
}

IDD_PG_GALLERY DIALOGEX 0, 0, 600, 330
STYLE DS_CONTROL | WS_CHILD
EXSTYLE WS_EX_CONTROLPARENT
FONT 9, "Segoe UI"
{
 PUSHBUTTON "&Open", IDC_RG_OPEN, 4, 4, 48, 14
 PUSHBUTTON "&Favourite", IDC_RG_FAVOURITE, 56, 4, 52, 14
 PUSHBUTTON "&New report", IDC_RG_NEW, 120, 4, 56, 14
 PUSHBUTTON "&Modify", IDC_RG_MODIFY, 180, 4, 48, 14
 PUSHBUTTON "&Copy", IDC_RG_COPY, 232, 4, 48, 14
 PUSHBUTTON "&Delete", IDC_RG_DELETE, 284, 4, 48, 14
 EDITTEXT IDC_RG_FILTER, 344, 4, 252, 12, ES_AUTOHSCROLL
 CONTROL "", IDC_RG_LIST, "SysListView32", LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | LVS_NOSORTHEADER | WS_BORDER | WS_TABSTOP, 4, 22, 592, 304
}
